      "type_action": "Export XLSX onglet Formateurs",
      "permission": "seances.view_seance"
    },
    {
      "module": "Séances & Emploi du temps",
      "libelle": "Export PDF Emploi du temps",
      "url": "/seances/groupe/<groupe_id>/export-pdf/",
      "route_django": "seances:export_pdf",
      "type_action": "Export PDF A4 Paysage",
      "permission": "seances.view_seance"
    },
    {
      "module": "Séances & Emploi du temps",
      "libelle": "Journal d'audit du planning",
