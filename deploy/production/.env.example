# ----------------------------------------------------------------------------
# INJS-LMD — modèle d'environnement de production (déploiement Docker Compose)
#
# Copier ce fichier en deploy/production/.env, adapter les valeurs, NE JAMAIS
# commiter de vrais secrets. Les valeurs ci-dessous sont des exemples non
# sensibles. Ce modèle ne contient QUE les variables réellement utilisées par
# le code et les nouveaux fichiers de déploiement.
# ----------------------------------------------------------------------------

# ============================================================================
# 1. Références des nouvelles images (jamais ophirdesire/injs-*:channel1-latest-amd64)
# INJS_BACKEND_TAG et INJS_FRONTEND_TAG doivent être des tags immuables,
# par exemple le SHA Git complet publié par le workflow de publication.
# ============================================================================
INJS_BACKEND_IMAGE=jckouassi/injs-be
INJS_BACKEND_TAG=  # requis : ex. a1b2c3d4e5f6... (SHA complet) ou v1.0.0
INJS_FRONTEND_IMAGE=jckouassi/injs-fe
INJS_FRONTEND_TAG=  # requis : ex. a1b2c3d4e5f6... (SHA complet) ou v1.0.0

# ============================================================================
# 2. Exposition publique et réseau Docker
# ============================================================================
INJS_PUBLIC_PORT=8080

# Nom du réseau Docker utilisé par la stack.
# Par défaut un réseau dédié est créé par Compose.
# Pour rejoindre un réseau externe déjà présent sur le VPS (ex. injs-net,
# où le conteneur PostgreSQL existant est accessible), décommentez :
#   INJS_NETWORK_NAME=injs-net
#   INJS_NETWORK_EXTERNAL=true
INJS_NETWORK_NAME=injs-net
INJS_NETWORK_EXTERNAL=true

# Noms des volumes persistants (médias et fichiers statiques).
# Utilisés uniquement si INJS_HOST_MEDIA_DIR / INJS_HOST_STATIC_DIR ne sont pas définis.
INJS_VOLUME_MEDIA=injs-lmd-media
INJS_VOLUME_STATIC=injs-lmd-staticfiles

# ============================================================================
# Montage bind des médias existants (continuité avec la production actuelle)
# ============================================================================
# La production actuelle sert les médias depuis le répertoire hôte
# /opt/injs/injs-be/data/media. Pour conserver l'accès à ces médias lors de
# la bascule, définir INJS_HOST_MEDIA_DIR sur ce chemin (exemple à confirmer
# sur le VPS). Sinon, le volume nommé INJS_VOLUME_MEDIA est utilisé.
# Exemple : INJS_HOST_MEDIA_DIR=/opt/injs/injs-be/data/media
# ============================================================================
INJS_HOST_MEDIA_DIR=/opt/injs/injs-be/data/media
# INJS_HOST_STATIC_DIR=  # Laisser vide → volume nommé injs-lmd-staticfiles / injs_staticfiles
# Règle stricte : n'utiliser Jamais /opt/injs/injs-be/data/static (répertoire introuvable)

# ============================================================================
# 3. Base de données PostgreSQL existante (non recréée par ce compose)
# Les noms POSTGRES_* correspondent aux réglages lus par backend/config/settings.py
# ============================================================================
POSTGRES_DB=injs
POSTGRES_USER=injs
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST ne doit PAS être 127.0.0.1 dans un conteneur Docker :
# renseigner l'IP ou le nom DNS du conteneur PostgreSQL existant, joignable
# depuis le réseau Docker (ex. le service PostgreSQL sur le réseau injs-net).
# Valeur à confirmer sur le VPS. Si vide, Django utilise son défaut (localhost).
POSTGRES_HOST=
POSTGRES_PORT=5432

# ============================================================================
# 4. Réglages Django requis en production
# ============================================================================
DJANGO_SECRET_KEY=change-me  # remplacer par une clé secrète forte (>= 50 caractères)
DJANGO_DEBUG=0
# If set to "true", SKIP_DB_SETUP will skip migrations/collectstatic/superuser auto-creation at startup.
# Must be paired with a gunicorn command in compose.yml to start the service.
SKIP_DB_SETUP=true
DJANGO_ALLOWED_HOSTS=injs.badge-qr-code.pro,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://injs.badge-qr-code.pro
CORS_ALLOWED_ORIGINS=https://injs.badge-qr-code.pro,http://localhost:3000

# ============================================================================
# 5. Redis (optionnel : cache partagé entre les workers Gunicorn)
# Définir uniquement si un service Redis est accessible en dehors de ce
# compose. Sinon laisser cette variable NON DÉFINIE (pas de chaîne vide) afin
# que Django utilise FileBasedCache (local au conteneur, comportement par
# défaut). Si vous la définissez, ajoutez aussi REDIS_URL à l'environnement
# du service backend dans compose.yml.
# Exemple : REDIS_URL=redis://redis:6379/0
# ============================================================================
# REDIS_URL=

# ============================================================================
# 6. URL publique des QR codes (backend, optionnel)
# Utilisée pour générer les URL de badgeage dans les QR codes.
# Exemple : BADGE_BASE_URL=https://injs.badge-qr-code.pro
# ============================================================================
# BADGE_BASE_URL=

# ============================================================================
# 7. Build du frontend (arguments passés au Dockerfile lors de la construction
# de l'image par le workflow de publication ; non lus au runtime du conteneur)
# ============================================================================
VITE_API_URL=https://injs.badge-qr-code.pro/api
VITE_BADGE_BASE_URL=https://injs.badge-qr-code.pro

# ============================================================================
# 8. Superuser Django initial (optionnel : création idempotente par l'entrypoint
# backend uniquement si DJANGO_SUPERUSER_EMAIL et DJANGO_SUPERUSER_PASSWORD sont définis)
# ============================================================================
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=INJS

# ============================================================================
# 9. Gunicorn (overrides optionnels des valeurs par défaut du Dockerfile)
# ============================================================================
GUNICORN_WORKERS=auto
GUNICORN_TIMEOUT=120