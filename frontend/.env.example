############################################
# Variables d'environnement pour le frontend (exemple)
#
# Ne pas commiter de vraies valeurs
# Copier ce fichier en .env.local pour le développement
############################################

# URL de base de l'API backend (sans slash final)
# Le préfixe /api est géré par le backend, pas par le frontend
# Exemple dev  : http://localhost:8001/api
# Cible INJS-LMD production (DNS pas encore configure) :
#   https://api-injs.badge-qr-code.pro/api
VITE_API_URL=http://localhost:8001/api

# URL de l'admin Django (optionnel — dérivée de VITE_API_URL si absent)
# Exemple dev  : http://localhost:8000/admin/
# Exemple prod : https://api.domaine-injs.org/admin/
# VITE_ADMIN_URL=http://localhost:8000/admin/

# Titre de l'application (optionnel)
# VITE_APP_TITLE=INJS-LMD — INJS Marcory

# URL de base de la page de badgeage Django (accessible par les téléphones qui scannent le QR)
# Doit correspondre à BADGE_BASE_URL dans le backend .env
# Exemple dev  : http://192.168.1.90:8001
# Exemple prod : https://api.example.com
VITE_BADGE_BASE_URL=http://localhost:8001
