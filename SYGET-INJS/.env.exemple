# Copier vers `.env` et adapter. Le fichier est chargé automatiquement au démarrage
# (manage.py, wsgi.py, asgi.py) si le paquet `python-dotenv` est installé.
# Les variables déjà définies dans le shell ne sont pas écrasées.
# Voir README pour la base Postgres Docker : service `db` du docker-compose.yml.

# ── Django ─────────────────────────────────────────────────
# Un seul module : `config.settings` (valeur par défaut dans manage.py / wsgi / asgi).
# DJANGO_SETTINGS_MODULE=config.settings
#
# Production : activer explicitement
# DJANGO_PRODUCTION=1
#
# Forcer SQLite (tests hors pytest, démo sans Postgres) :
# DJANGO_USE_SQLITE=1

# ── Base PostgreSQL (hors tests, hors DJANGO_USE_SQLITE) ─────
# Variables principales utilisées par l'application.
POSTGRES_DB=emploi_du_temps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Compatibilité ancienne config (optionnel)
# DB_NAME=emploi_du_temps
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ── Production (avec DJANGO_PRODUCTION=1) ────────────────────
# Obligatoire en prod :
# DJANGO_SECRET_KEY=changez-moi-long-et-aleatoire
# ALLOWED_HOSTS=example.com,www.example.com
# POSTGRES_DB=emploi_du_temps
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ── Aperçu iframe / proxy (développement / SQLite) ─────────
# ALLOWED_HOSTS=localhost,127.0.0.1,.e2b.app
# CSRF_TRUSTED_ORIGINS=https://*.e2b.app
# DJANGO_TRUST_PROXY_SSL=1
# DJANGO_ALLOW_IFRAME=1
# DJANGO_IFRAME_COOKIES=1

