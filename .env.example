# ---- Django (injs-be) ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=injs.badge-qr-code.pro,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://injs.badge-qr-code.pro
CORS_ALLOWED_ORIGINS=https://injs.badge-qr-code.pro,http://localhost:3000

# ---- Base de données (DB_* du .env VPS) ----
DB_ENGINE=django.db.backends.postgresql
DB_NAME=injs
DB_USER=injs
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ---- Frontend (injs-fe) ----
VITE_API_URL=https://injs.badge-qr-code.pro/api

# ---- Identité institutionnelle des documents officiels (exports PDF/Excel) ----
# Nom imprimé en en-tête ; laisser vide pour utiliser le nom officiel codé
# (« Institut National de la Jeunesse et des Sports (INJS) »).
INJS_NOM_OFFICIEL=
# Adresse postale imprimée en pied de page. Vide par défaut : aucune adresse
# n'est inventée. À renseigner dès que l'adresse officielle est fournie.
INJS_ADRESSE_OFFICIELLE=
