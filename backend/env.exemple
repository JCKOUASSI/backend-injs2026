############################################
# Variables d'environnement (exemple)
#
# Ne pas commiter de vraies valeurs
# (surtout `SECRET_KEY`).
############################################

# Clé Django (secret)
SECRET_KEY=change-moi-avant-deployer

# Activer/Désactiver debug (true/false)
DEBUG=true

# Hostname public éventuellement fourni par la plateforme d’hébergement (optionnel).
RENDER_EXTERNAL_HOSTNAME=

# Hôtes Django autorisés (sans schéma), séparés par des virgules.
DJANGO_ALLOWED_HOSTS=api.example.com,localhost

# Origines CORS autorisées : http(s)://host:port, séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Origines CSRF (schéma + host + port si besoin).
CSRF_TRUSTED_ORIGINS=https://api.example.com,http://localhost:3000

# URL publique pour les liens QR vus par les téléphones (prod).
BADGE_BASE_URL=https://api.example.com

# URL du frontend React (redirect depuis / si utilisé).
FRONTEND_URL=https://app.example.com

# ── PostgreSQL (voir aussi `.env.example`) ───────────────────
POSTGRES_DB=qr_badge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dossier du cache fichier (FileBasedCache, utilisé en production)
# Le dossier doit être accessible en lecture/écriture par le serveur
CACHE_DIR=/data/cache

# Throttling DRF
# Format DRF: "N/min", "N/hour", etc.
THROTTLE_LOGIN_RATE=5/min
THROTTLE_SCAN_RATE=60/min

# Délai (en minutes) après la fin d'une séance avant de marquer un auditeur ABSENT_NON_BADGE
# Déclenché par: python manage.py auto_close_pointages
# Défaut : 60 minutes
AUTO_ABSENT_DELAI_MINUTES=60

# ── Email SMTP (Mailcow) ────────────────────────────────────
# En développement, laisser vide → les emails s'affichent dans la console Django.
# En production, renseigner les valeurs de votre serveur Mailcow.
#
# Port 587 — STARTTLS (recommandé) :
EMAIL_HOST=mail.ton-domaine.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@ton-domaine.com
EMAIL_HOST_PASSWORD=mot_de_passe_mailcow
DEFAULT_FROM_EMAIL=INJS-LMD <noreply@ton-domaine.com>
#
# Port 465 — SSL/TLS direct (alternative) :
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
#
# Pour forcer un backend particulier (optionnel) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

