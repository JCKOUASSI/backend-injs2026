# Copier vers .env : cp .env.example .env
# Le fichier .env est ignoré par Git — ne commitez pas de secrets.

# ── Django général ─────────────────────────────────────────
DEBUG=True
SECRET_KEY=
# En prod : définir une clé forte. Si vide + DEBUG=True, Django utilise une clé de dev.

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Hôtes autorisés, séparés par des virgules.

RENDER_EXTERNAL_HOSTNAME=
# Optionnel : hostname public injecté par certains hébergeurs (reverse proxy).

BADGE_BASE_URL=http://localhost:8001
# URL publique pour les liens QR (téléphones). Vide = auto en DEBUG (port DJANGO_DEV_PORT).

DJANGO_DEV_PORT=8001
# Port du serveur Django en local (runserver, BADGE_BASE_URL auto, CORS/CSRF).

PUBLIC_APP_URL=http://localhost:3000
# URL de l'application web (bouton « Voir le site » dans l'admin).

CSRF_TRUSTED_ORIGINS=
# Origines CSRF, séparées par des virgules. Ex: http://192.168.1.10:8001

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=injs_lmd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Réutilise les connexions PostgreSQL entre requêtes (réduit la latence en pic de badgeage).
# DB_CONN_MAX_AGE=60

# ── Cache (production, DEBUG=False) ─────────────────────────
CACHE_DIR=
# Scaling horizontal (plusieurs conteneurs app) : cache Redis partagé
REDIS_URL=
# Ex: redis://redis:6379/0  (service redis dans compose.yml)

# ── Gunicorn / scaling ──────────────────────────────────────
# auto = (2 × CPU) + 1, borné par MIN/MAX au démarrage
GUNICORN_WORKERS=auto
GUNICORN_WORKERS_MIN=2
GUNICORN_WORKERS_MAX=10
# Ajuste les workers en runtime selon la charge (TTIN/TTOU)
GUNICORN_AUTOSCALE=true
GUNICORN_AUTOSCALE_INTERVAL=30
GUNICORN_AUTOSCALE_LOAD_UP=0.8
GUNICORN_AUTOSCALE_LOAD_DOWN=0.3

# ── Throttling DRF ─────────────────────────────────────────
THROTTLE_LOGIN_RATE=20/min
THROTTLE_SCAN_RATE=60/min

# ── Présences / mobile (backend) ───────────────────────────
AUTO_ABSENT_DELAI_MINUTES=60
# true = désactive temporairement suspect / sortie auto + envoi heartbeat mobile
# MOBILE_HEARTBEAT_DISABLED=true
# Intervalle heartbeat imposé aux apps (secondes, 30–600 ; défaut 60)
# MOBILE_HEARTBEAT_INTERVAL_SECONDS=60
# Intervalle entre deux traces AuditLog heartbeat (défaut 600 s = 10 min).
# MOBILE_HEARTBEAT_AUDIT_INTERVAL_SECONDS=600
MOBILE_HEARTBEAT_SUSPECT_TIMEOUT_MINUTES=60
MOBILE_HEARTBEAT_AUTO_EXIT_TIMEOUT_MINUTES=120
MOBILE_GEOFENCE_DEFAULT_RADIUS_M=200
MOBILE_GEOFENCE_MAX_ACCURACY_M=80
MOBILE_GEOFENCE_OUTSIDE_CONFIRMATIONS=2

# ── Frontend (page d'accueil /api/) ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS (frontend / apps) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=
# Ex: http://localhost:3000,http://127.0.0.1:3000

# ── Email SMTP ──────────────────────────────────────────────
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=

# ── Badgeage QR public (web) — false en production ───────────
# Préférer l'app mobile (/api/scan/secure/). true uniquement en dev/local.
PUBLIC_QR_SCAN_ENABLED=False

# ── Superutilisateur auto (post_migrate) ─────────────────────
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ── Synchronisation inter-plateformes (système partenaire) ──────
# Clé partagée entre la plateforme INJS-LMD et le système partenaire.
# Doit être identique dans les deux .env.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
INTER_PLATFORM_API_KEY=
