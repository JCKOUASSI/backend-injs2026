<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      En debug uniquement, Gradle utilise src/debug/res/xml/network_security_config.xml
      (cleartextTrafficPermitted="true") a la place de celui de src/main/.
      usesCleartextTraffic n'est pas necesssaire ici : c'est le networkSecurityConfig
      qui fait autorite quand les deux attributs sont presents.
    -->
</manifest>
