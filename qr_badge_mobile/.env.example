# Copie optionnelle : non utilisée par défaut par Flutter (l’app charge assets/app.env).
# Pour surcharger en local sans modifier assets/app.env, vous pouvez :
# - éditer assets/app.env (versionné), ou
# - utiliser flutter run --dart-define=API_BASE_URL=http://...

API_BASE_URL=http://127.0.0.1:8001
# Optionnel : URL HTTPS de la politique (Play Store). Sinon dérivée de API_BASE_URL + /dashboard/legal/...
# URL actuellement publiée (espace GitHub Pages hérité ; renommage/déploiement fléché LOT 12, DA-12) :
PRIVACY_POLICY_URL=https://tobi-nw.github.io/legalsygepcpfae/legal/confidentialite-qr-badge-mobile.html
SUPERVISOR_LOGOUT_CODE=your-supervisor-logout-code
DEV_API_HOST=
DEV_API_PORT=8001

# false = pas d'envoi heartbeat ni service arrière-plan (tests / debug)
# HEARTBEAT_ENABLED=false

# Secondes entre deux heartbeats auto (30–600)
HEARTBEAT_INTERVAL_SECONDS=60
